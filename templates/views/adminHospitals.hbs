<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800">
    {{>header}}

    <main class="container mx-auto px-5 py-10">
        <div class="mb-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-purple-600">Admin Module</p>
                    <h1 class="mt-2 text-3xl font-semibold text-gray-900">Hospital Management</h1>
                    <p class="mt-2 text-gray-600">Approve new hospitals, deactivate accounts, and keep access under control.</p>
                </div>
                <a href="/admin/dashboard" class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100">Back to Dashboard</a>
            </div>
        </div>

        <form method="get" action="/admin/hospitals" class="mb-6 flex flex-col gap-3 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:flex-row md:items-center">
            <input type="text" name="q" value="{{searchTerm}}" placeholder="Search by hospital name or email" class="w-full rounded-lg border border-gray-300 px-4 py-2 md:max-w-md">
            <select name="status" class="rounded-lg border border-gray-300 px-4 py-2">
                <option value="">All statuses</option>
                <option value="Active" {{#if (eq statusFilter 'Active')}}selected{{/if}}>Active</option>
                <option value="Pending" {{#if (eq statusFilter 'Pending')}}selected{{/if}}>Pending</option>
            </select>
            <button type="submit" class="rounded-lg bg-purple-600 px-4 py-2 font-medium text-white hover:bg-purple-700">Filter</button>
        </form>

        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-gray-700">Hospital</th>
                            <th class="px-4 py-3 text-left font-semibold text-gray-700">Email</th>
                            <th class="px-4 py-3 text-left font-semibold text-gray-700">Role</th>
                            <th class="px-4 py-3 text-left font-semibold text-gray-700">Status</th>
                            <th class="px-4 py-3 text-left font-semibold text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {{#if hasResults}}
                        {{#each hospitals}}
                        <tr>
                            <td class="px-4 py-3 font-medium text-gray-900">{{this.name}}</td>
                            <td class="px-4 py-3 text-gray-600">{{this.email}}</td>
                            <td class="px-4 py-3 text-gray-600">{{#if (eq this.role 1)}}Admin{{else}}Doctor{{/if}}</td>
                            <td class="px-4 py-3">
                                {{#if (eq this.status 'Active')}}
                                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">Active</span>
                                {{else}}
                                <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">Pending</span>
                                {{/if}}
                            </td>
                            <td class="px-4 py-3">
                                {{#if (eq this.status 'Active')}}
                                <form action="/admin/hospitals/{{this._id}}/deactivate" method="post" class="inline">
                                    <button type="submit" class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-700 hover:bg-amber-100">Deactivate</button>
                                </form>
                                {{else}}
                                <form action="/admin/hospitals/{{this._id}}/activate" method="post" class="inline">
                                    <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-700">Approve</button>
                                </form>
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-gray-500">No matching hospitals found.</td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    {{>footer}}
</body>
</html>
