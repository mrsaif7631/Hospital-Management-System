<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800">
    {{>header}}

    <main class="container mx-auto px-5 py-10">
        <div class="mb-8 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 p-8 text-white shadow-xl">
            <p class="text-sm uppercase tracking-[0.3em] opacity-80">Admin Control Center</p>
            <h1 class="mt-2 text-3xl font-semibold">Welcome back, {{name}}</h1>
            <p class="mt-3 max-w-2xl text-purple-100">Monitor hospital registrations, review pending accounts, and manage access in one place.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-4">
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Total Hospitals</p>
                <p class="mt-2 text-3xl font-bold text-gray-900">{{totalHospitals}}</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Pending Approval</p>
                <p class="mt-2 text-3xl font-bold text-amber-600">{{pendingHospitals}}</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Active Accounts</p>
                <p class="mt-2 text-3xl font-bold text-emerald-600">{{activeHospitals}}</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Admin / Doctor</p>
                <p class="mt-2 text-2xl font-bold text-indigo-600">{{adminCount}} / {{doctorCount}}</p>
            </div>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <div class="mb-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900">Recent Hospital Activity</h2>
                        <p class="text-sm text-gray-500">Latest registrations and account status updates.</p>
                    </div>
                    <a href="/admin/hospitals" class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-700">Manage Hospitals</a>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left font-semibold text-gray-700">Hospital</th>
                                <th class="px-4 py-3 text-left font-semibold text-gray-700">Email</th>
                                <th class="px-4 py-3 text-left font-semibold text-gray-700">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {{#each latestHospitals}}
                            <tr>
                                <td class="px-4 py-3 font-medium text-gray-900">{{this.name}}</td>
                                <td class="px-4 py-3 text-gray-600">{{this.email}}</td>
                                <td class="px-4 py-3">
                                    {{#if (eq this.status 'Active')}}
                                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">Active</span>
                                    {{else}}
                                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">Pending</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold text-gray-900">Quick Actions</h2>
                <div class="mt-4 space-y-3">
                    <a href="/admin/hospitals" class="block rounded-xl border border-purple-200 bg-purple-50 px-4 py-3 text-sm font-medium text-purple-700 hover:bg-purple-100">Review and approve hospital accounts</a>
                    <a href="/home" class="block rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100">Return to main dashboard</a>
                </div>
            </div>
        </div>
    </main>

    {{>footer}}
</body>
</html>
