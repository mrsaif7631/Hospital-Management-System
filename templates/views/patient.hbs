<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Patients</title>

    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>

<body>

    {{> header}}

    <!-- Dashboard -->
    <section class="text-gray-600 body-font">
        <div class="container px-5 py-12 mx-auto">
            <div class="flex flex-wrap -m-4 text-center">

                <div class="p-4 sm:w-1/3 w-full">
                    <h2 class="text-4xl font-bold text-purple-600">
                        {{totalPatients}}
                    </h2>
                    <p>Total Patients</p>
                </div>

                <div class="p-4 sm:w-1/3 w-full">
                    <h2 class="text-4xl font-bold text-green-600">
                        {{admittedPatients}}
                    </h2>
                    <p>Admitted</p>
                </div>

                <div class="p-4 sm:w-1/3 w-full">
                    <h2 class="text-4xl font-bold text-red-600">
                        {{dischargedPatients}}
                    </h2>
                    <p>Discharged</p>
                </div>

            </div>
        </div>
    </section>

    <hr class="hr-1">

    <!-- Add Patient Section -->
<section class="text-gray-600 body-font">

    <div class="container px-5 py-12 mx-auto">

        <div class="flex flex-wrap justify-center gap-4">

            <div>
                <a
                    href="/patients/add"
                    class="bg-purple-500 hover:bg-purple-600 text-white py-2 px-8 rounded text-lg inline-block">
                    Add Patient
                </a>
            </div>

            <div>
                <a
                    href="/patients/search"
                    class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-8 rounded text-lg inline-block">
                    Search Patient
                </a>
            </div>

            <div>
                <a
                    href="/dashboard"
                    class="bg-red-500 hover:bg-red-600 text-white py-2 px-8 rounded text-lg inline-block">
                    Close
                </a>
            </div>

        </div>

    </div>

</section>

    <!-- Patients List -->

    <section class="text-gray-600 body-font">

        <div class="container px-5 py-12 mx-auto">

            <h1 class="text-3xl font-bold text-center mb-8">
                PATIENTS LIST
            </h1>

            {{#if message}}
            <div class="mb-6 rounded-lg bg-green-100 border border-green-300 text-green-700 px-4 py-3 text-center">
                {{message}}
            </div>
            {{/if}}

            <div class="overflow-x-auto">

                <table class="table-auto w-full shadow-lg">

                    <thead>

                        <tr>

                            <th class="bg-purple-500 text-white py-3">Patient ID</th>
                            <th class="bg-purple-500 text-white py-3">Name</th>
                            <th class="bg-purple-500 text-white py-3">Phone</th>
                            <th class="bg-purple-500 text-white py-3">Date</th>
                            <th class="bg-purple-500 text-white py-3">Details</th>

                        </tr>

                    </thead>

                    <tbody>

                        {{#if patients.length}}

                        {{#each patients}}

                        <tr class="text-center border-b hover:bg-gray-100">

                            <td class="py-3">{{this._id}}</td>

                            <td>{{this.name}}</td>

                            <td>{{this.phone}}</td>

                            <td>{{this.formattedDate}}</td>

                            <td>

                                <a
                                    href="/getPat/{{this._id}}"
                                    class="bg-blue-500 hover:bg-blue-700 text-white px-4 py-2 rounded">

                                    View

                                </a>

                            </td>

                        </tr>

                        {{/each}}

                        {{else}}

                        <tr>
                            <td colspan="5" class="py-8 text-center text-gray-500">
                                No patients found yet. Add a patient to get started.
                            </td>
                        </tr>

                        {{/if}}

                    </tbody>

                </table>

            </div>

        </div>

    </section>

    {{> footer}}

</body>

</html>