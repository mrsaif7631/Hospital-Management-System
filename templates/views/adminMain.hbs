<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>

<body>

    {{>header}}

    <!-- Welcome -->
    <section class="text-gray-600 body-font">
        <div class="container px-5 pt-6 mx-auto text-center">
            <h1 class="text-2xl font-semibold text-gray-700">
                Welcome
            </h1>
            <h2 class="text-4xl font-bold text-purple-600 mt-2">
                {{name}}
            </h2>
            <p class="mt-3 text-gray-500">
                Hospital Management System - Administrator Dashboard
            </p>
        </div>
    </section>

    <!-- Banner -->
    <section class="text-gray-600 body-font">
        <div class="container px-5 py-8 mx-auto">
            <img class="rounded-lg shadow-lg w-full"
                src="/images/3.jpg"
                alt="Hospital Banner">
        </div>
    </section>

    <hr class="hr-1">

    <!-- Dashboard Cards -->
    <section class="text-gray-600 body-font">
        <div class="container px-5 py-16 mx-auto">

            <div class="text-center mb-12">
                <h1 class="text-3xl font-bold text-gray-800">
                    Admin Dashboard
                </h1>

                <p class="mt-3 text-gray-500">
                    Manage your hospital from one place.
                </p>
            </div>

            <div class="flex flex-wrap -m-4">

                <!-- Add Patient -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            Add Patient
                        </h2>

                        <p class="mb-6 text-gray-500">
                            Register new patients into the hospital system.
                        </p>

                        <a href="/patients/add"
                            class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded">
                            Add Patient
                        </a>

                    </div>
                </div>

                <!-- View Patients -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            Patients
                        </h2>

                        <p class="mb-6 text-gray-500">
                            View, edit and manage patient records.
                        </p>

                        <a href="/patients"
                            class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded">
                            View Patients
                        </a>

                    </div>
                </div>

                <!-- Profile -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            My Profile
                        </h2>

                        <p class="mb-6 text-gray-500">
                            Update hospital information and account settings.
                        </p>

                        <a href="/profile"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded">
                            View Profile
                        </a>

                    </div>
                </div>

                <!-- Appointments -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            Appointments
                        </h2>

                        <p class="mb-6 text-gray-500">
                            Manage appointments and schedules.
                        </p>

                        <a href="/appointments"
                            class="bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-2 rounded">
                            Open
                        </a>

                    </div>
                </div>

                <!-- Doctors -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            Doctors
                        </h2>

                        <p class="mb-6 text-gray-500">
                            View and manage doctors information.
                        </p>

                        <a href="/doctors"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded">
                            Manage
                        </a>

                    </div>
                </div>

                <!-- Logout -->
                <div class="p-4 md:w-1/3">
                    <div class="border rounded-lg shadow hover:shadow-xl p-8 text-center">

                        <h2 class="text-2xl font-semibold mb-4">
                            Logout
                        </h2>

                        <p class="mb-6 text-gray-500">
                            Sign out from your administrator account.
                        </p>

                        <a href="/logout"
                            class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded">
                            Logout
                        </a>

                    </div>
                </div>

            </div>

        </div>
    </section>

    <hr class="hr-1">

    <!-- About -->
    <section class="text-gray-600 body-font">
        <div class="container mx-auto flex px-5 py-20 md:flex-row flex-col items-center">

            <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6">
                <img class="object-cover object-center rounded-lg"
                    src="/images/d1.jpg"
                    alt="">
            </div>

            <div class="lg:flex-grow md:w-1/2 lg:pl-20 md:pl-10 flex flex-col md:items-start md:text-left items-center text-center">

                <h1 class="text-4xl font-bold text-gray-800 mb-4">
                    Administrator Panel
                </h1>

                <p class="leading-relaxed text-lg">
                    The Hospital Management System Admin Dashboard provides a
                    centralized place to manage patients, doctors,
                    appointments and hospital records efficiently.
                    It helps administrators monitor and control all hospital
                    operations from one secure interface.
                </p>

            </div>

        </div>
    </section>

    <hr class="hr-1">

    {{>footer}}

    <script src="/js/app.js"></script>

</body>

</html>