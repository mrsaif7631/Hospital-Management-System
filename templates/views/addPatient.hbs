<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Patient</title>

    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-gray-100">

<section class="text-gray-600 body-font">

    <div class="container px-5 py-10 mx-auto">

        <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-lg p-8">

            <h1 class="text-3xl font-bold text-center mb-8">
                Add New Patient
            </h1>

            <form action="/patients/add" method="POST">

                <div class="mb-5">
                    <label class="font-semibold">Patient Name</label>
                    <input
                        type="text"
                        name="name"
                        required
                        class="w-full border rounded-lg p-3"
                        placeholder="Enter Patient Name">
                </div>

                <div class="mb-5">
                    <label class="font-semibold">Gender</label>

                    <select
                        name="gender"
                        required
                        class="w-full border rounded-lg p-3">

                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>

                    </select>

                </div>

                <div class="mb-5">
                    <label class="font-semibold">Age</label>

                    <input
                        type="number"
                        name="age"
                        min="1"
                        max="120"
                        required
                        class="w-full border rounded-lg p-3">
                </div>

                <div class="mb-5">
                    <label class="font-semibold">Weight (kg)</label>

                    <input
                        type="number"
                        name="weight"
                        step="0.1"
                        min="1"
                        required
                        class="w-full border rounded-lg p-3">
                </div>

                <div class="mb-5">
                    <label class="font-semibold">Phone</label>

                    <input
                        type="tel"
                        name="phone"
                        maxlength="10"
                        minlength="10"
                        required
                        class="w-full border rounded-lg p-3"
                        placeholder="9876543210">
                </div>

                <div class="mb-5">
                    <label class="font-semibold">Address</label>

                    <textarea
                        name="address"
                        rows="4"
                        required
                        class="w-full border rounded-lg p-3"></textarea>

                </div>

                <div class="mb-6">

                    <label class="font-semibold">Status</label>

                    <select
                        name="status"
                        required
                        class="w-full border rounded-lg p-3">

                        <option value="">Select Status</option>
                        <option>Admit</option>
                        <option>Discharged</option>

                    </select>

                </div>

                <div class="flex gap-4">

                    <button
                        type="submit"
                        class="bg-purple-600 hover:bg-purple-700 text-white px-8 py-3 rounded-lg">

                        Add Patient

                    </button>

                    <a
                        href="/patients"
                        class="bg-gray-500 hover:bg-gray-600 text-white px-8 py-3 rounded-lg">

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</section>

</body>
</html>