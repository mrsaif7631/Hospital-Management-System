<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Approve Hospital</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800">
    <main class="container mx-auto flex min-h-screen items-center justify-center px-5 py-10">
        <div class="w-full max-w-2xl rounded-3xl border border-gray-200 bg-white p-8 shadow-xl">
            <div class="mb-6 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 p-6 text-white">
                <p class="text-sm uppercase tracking-[0.3em] opacity-80">Admin Approval</p>
                <h1 class="mt-2 text-3xl font-semibold">Approve Hospital Access</h1>
                <p class="mt-3 text-purple-100">Review the hospital details below and confirm activation.</p>
            </div>

            <div class="space-y-4 text-sm text-gray-700">
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="rounded-xl bg-gray-50 p-4">
                        <p class="font-semibold text-gray-500">Hospital Name</p>
                        <p class="mt-1 text-lg font-semibold text-gray-900">{{hospital.name}}</p>
                    </div>
                    <div class="rounded-xl bg-gray-50 p-4">
                        <p class="font-semibold text-gray-500">Email</p>
                        <p class="mt-1 text-lg font-semibold text-gray-900">{{hospital.email}}</p>
                    </div>
                </div>

                <div class="rounded-xl border border-gray-200 p-4">
                    <p class="font-semibold text-gray-500">Current Status</p>
                    <p class="mt-2 inline-flex rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-700">Pending</p>
                </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a href="{{approvalUrl}}" class="flex-1 rounded-xl bg-emerald-600 px-5 py-3 text-center font-semibold text-white hover:bg-emerald-700">Approve Account</a>
                <a href="/" class="flex-1 rounded-xl border border-gray-300 px-5 py-3 text-center font-semibold text-gray-700 hover:bg-gray-100">Cancel</a>
            </div>
        </div>
    </main>
</body>
</html>
