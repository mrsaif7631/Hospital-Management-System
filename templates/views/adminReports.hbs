<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Reports</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-800">
    {{>header}}

    <main class="container mx-auto px-5 py-10">
        <div class="mb-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
            <h1 class="text-3xl font-semibold text-gray-900">Admin Reports</h1>
            <p class="mt-2 text-gray-600">A professional summary view for hospital administration.</p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Pending Requests</p>
                <p class="mt-2 text-3xl font-bold text-amber-600">{{pendingHospitals}}</p>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Active Hospitals</p>
                <p class="mt-2 text-3xl font-bold text-emerald-600">{{activeHospitals}}</p>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-medium text-gray-500">Total Accounts</p>
                <p class="mt-2 text-3xl font-bold text-purple-600">{{totalHospitals}}</p>
            </div>
        </div>
    </main>

    {{>footer}}
</body>
</html>
